{% for g in market.groups %}
<div class="market-group">
  <h3>{{ g.label }}</h3>
  <table class="market-table">
    <thead>
      <tr><th scope="col">Valeur</th><th scope="col">Cours</th><th scope="col">1 j</th><th scope="col">1 sem</th><th scope="col">1 mois</th></tr>
    </thead>
    <tbody>
      {% for r in g.rows %}
      <tr{% if r.stale %} class="stale" title="Cours non mis à jour (donnée de la veille)"{% endif %}>
        <td>{{ r.name }}<span class="sym">{{ r.symbol }}</span></td>
        <td>{{ r.price | price(r.currency) }}</td>
        {% for k in ("d1", "w1", "m1") %}
        <td class="{{ r[k] | trend }}">{{ r[k] | pct }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endfor %}

{% if market.earnings %}
<div class="market-group">
  <h3>Prochains résultats</h3>
  <ul class="earnings">
    {% for e in market.earnings %}
    <li><time datetime="{{ e.date }}">{{ e.date | short_date }}</time><span>{{ e.name }}</span></li>
    {% endfor %}
  </ul>
</div>
{% endif %}

<p class="market-note">
  Cours de clôture (Yahoo Finance), relevés le {{ market.updated_label }}. Dates de résultats indicatives.
  {% if market.errors %}<br>Indisponibles : {{ market.errors | join(", ") }}.{% endif %}
</p>
