{% extends "base.html.j2" %}
{% from "_macros.html.j2" import filters, feed, sidebar_box with context %}

{% block main %}
<div class="layout">
  <section class="content" aria-labelledby="page-title">
    <header class="page-head">
      <h1 id="page-title">{{ title }} <span class="count" data-count>{{ count }}</span></h1>
      <p>{{ subtitle }}</p>
    </header>
    {{ filters(options, periods, display_days, default_domain if page != 'geopolitique' else 'all', kind=kind,
               show_segments=(kind == 'company'), show_domain=(page != 'geopolitique'),
               show_themes=(page == 'geopolitique')) }}
    {% if world %}
    <figure class="card map-card" data-map>
      <figcaption class="viz-head">
        <div>
          <h2>Intensité par pays</h2>
          <p>Sujets selon les filtres ci-dessus · clic sur un pays : filtrer le fil · double-clic : sa fiche</p>
        </div>
      </figcaption>
      <svg class="worldmap" viewBox="0 0 {{ world.width }} {{ world.height }}" role="img"
           aria-label="Carte du monde : nombre de sujets par pays (détail dans la liste des pays)">
        <path class="land-other" d="{{ world.others }}"/>
        {% for code, d in world.shapes.items() %}
        <path class="land m0" data-country="{{ code }}" data-name="{{ world.names.get(code, code) }}" d="{{ d }}"/>
        {% endfor %}
      </svg>
      <div class="map-legend" aria-hidden="true">
        <span>Moins</span>{% for b in range(1, 6) %}<span class="scale-step m{{ b }}"></span>{% endfor %}<span data-map-max>Plus</span>
      </div>
      <div class="tip map-tip" role="status" hidden></div>
    </figure>
    {% endif %}
    {{ feed(groups, root) }}
  </section>

  <aside class="side">
    {% for box in sidebars %}{{ sidebar_box(box, root, open=loop.first) }}{% endfor %}
  </aside>
</div>
{% endblock %}
