<!doctype html>
<html lang="fr">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <meta name="color-scheme" content="light dark">
  <meta name="robots" content="noindex">
  <title>Veille Géospatial & New Space</title>
  <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 32 32'%3E%3Ccircle cx='16' cy='16' r='6' fill='%232563eb'/%3E%3Cellipse cx='16' cy='16' rx='14' ry='5' fill='none' stroke='%232563eb' stroke-width='2' transform='rotate(-25 16 16)'/%3E%3C/svg%3E">
  <link rel="stylesheet" href="static/style.css?v={{ asset_version }}">
</head>
<body data-display-days="{{ display_days }}">
  <header class="top">
    <div class="top-inner">
      <div class="brand">
        <h1>Veille <span>Géospatial &amp; New Space</span></h1>
        <p class="updated">Mis à jour le <time datetime="{{ updated_at.isoformat() }}">{{ updated_label }}</time></p>
      </div>

      <div class="controls">
        <div class="segmented" role="group" aria-label="Filtrer par domaine">
          <button type="button" data-domain="geospatial" aria-pressed="true">Géospatial</button>
          <button type="button" data-domain="newspace" aria-pressed="false">New Space</button>
          <button type="button" data-domain="all" aria-pressed="false">Tout</button>
        </div>
        <label class="search">
          <span class="sr-only">Rechercher</span>
          <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M8.5 3a5.5 5.5 0 0 1 4.38 8.83l3.65 3.64-1.06 1.06-3.64-3.65A5.5 5.5 0 1 1 8.5 3Zm0 1.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z" fill="currentColor"/></svg>
          <input type="search" id="q" placeholder="Rechercher (ex. ICEYE, Ariane, SAR…)" autocomplete="off">
        </label>
        <div class="segmented small" role="group" aria-label="Période affichée">
          <button type="button" data-days="{{ display_days }}" aria-pressed="true">{{ display_days }} j</button>
          <button type="button" data-days="{{ retention_days }}" aria-pressed="false">{{ retention_days }} j</button>
        </div>
      </div>

      <nav class="jump" aria-label="Rubriques">
        {% for s in sections %}<a href="#{{ s.key }}">{{ s.title }}</a>{% endfor %}
        <a href="#marche">Marché</a>
      </nav>
    </div>
  </header>

  <main class="grid">
    {% for s in sections %}
    <section class="col" id="{{ s.key }}" aria-labelledby="h-{{ s.key }}">
      <header class="col-head">
        <h2 id="h-{{ s.key }}">{{ s.title }} <span class="count" data-count></span></h2>
        <p>{{ s.subtitle }}</p>
      </header>
      <div class="col-body">
        {% for g in s.groups %}
        <div class="day" data-age="{{ g.age_days }}">
          <h3 class="day-label">{{ g.label }}</h3>
          {% for row in g["items"] %}
          {% set i = row.item %}
          <article class="item" data-tags="{{ i.tags | join(' ') }}" data-search="{{ row.search }}">
            <h4><a href="{{ i.url }}" target="_blank" rel="noopener noreferrer">{{ i.title }}</a></h4>
            <p class="meta">
              <span class="src">{{ i.source }}</span>
              <span aria-hidden="true">·</span>
              <time datetime="{{ i.published }}">{% if i.date_estimated %}≈ {% endif %}{{ row.time }}</time>
              {% for t in i.tags %}<span class="tag tag-{{ t }}">{{ 'Géo' if t == 'geospatial' else 'New Space' }}</span>{% endfor %}
            </p>
            {% if i.summary %}<p class="excerpt">{{ i.summary }}</p>{% endif %}
          </article>
          {% endfor %}
        </div>
        {% endfor %}
        <p class="empty" hidden>Aucun article pour ce filtre.</p>
      </div>
    </section>
    {% endfor %}

    <section class="col col-market" id="marche" aria-labelledby="h-marche">
      <header class="col-head">
        <h2 id="h-marche">Marché</h2>
        <p>Spatial, géospatial et défense cotés</p>
      </header>
      <div class="col-body">
        {% if market %}
        {% include "market.html.j2" %}
        {% else %}
        <p class="placeholder">Les cours seront ajoutés à l'étape 3.</p>
        {% endif %}
      </div>
    </section>
  </main>

  <footer class="foot">
    <p>
      {{ sources_ok | length }} sources actives.
      Titres et extraits fournis par les flux RSS des éditeurs ; cliquez pour lire l'article sur le site source.
    </p>
    {% if sources_err %}
    <p class="errors">
      Sources en erreur lors de la dernière mise à jour :
      {% for s in sources_err %}<span title="{{ s.url }}">{{ s.name }} ({{ s.error }})</span>{% if not loop.last %}, {% endif %}{% endfor %}
    </p>
    {% endif %}
  </footer>

  <script src="static/app.js?v={{ asset_version }}"></script>
</body>
</html>
