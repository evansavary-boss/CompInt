{# Shared building blocks: one story (articles about the same news), the filter bar, the feed. #}

{% macro story_card(row, root, current=None) %}
<article class="item story{% if row.impact %} impact-{{ row.impact }}{% endif %}"
  data-tags="{{ row.tags | join(' ') }}"
  data-entities="{{ row.entity_ids | join(' ') }}"
  data-countries="{{ row.countries | join(' ') }}"
  data-regions="{{ row.regions | join(' ') }}"
  data-events="{{ row.event_keys | join(' ') }}"
  data-segments="{{ row.segments | join(' ') }}"
  data-industries="{{ row.industries | map('first') | join(' ') }}"
  data-themes="{{ row.theme_keys | join(' ') }}"
  data-moves="{{ row.move_keys | join(' ') }}"
  data-impact="{{ row.impact_rank }}"
  data-age="{{ row.age }}"
  data-search="{{ row.search }}">
  <h4><a href="{{ row.url }}" target="_blank" rel="noopener noreferrer">{{ row.title }}</a></h4>
  <p class="meta">
    {% if row.impact %}<span class="impact-badge impact-badge-{{ row.impact }}">{{ row.impact_label }}</span>{% endif %}
    <span class="src">{{ row.source }}</span>{% if row.via == 'gnews' %}<span class="via" title="Trouvé via Google News"> · GN</span>{% endif %}
    {% if row.n_sources > 1 %}<span class="n-sources">+ {{ row.n_sources - 1 }} source{{ 's' if row.n_sources > 2 }}</span>{% endif %}
    <span aria-hidden="true">·</span>
    <time datetime="{{ row.last.isoformat() }}" title="{{ row.date }}">{{ row.time }}</time>
    {% if row.countries %}<span aria-hidden="true">·</span> <span class="geo">
      {%- for code in row.countries[:3] -%}
      {%- if not loop.first %}, {% endif -%}
      {%- if code in country_pages %}<a href="{{ root }}pays/{{ code }}.html">{{ row.country_names[loop.index0] }}</a>{% else %}{{ row.country_names[loop.index0] }}{% endif -%}
      {%- endfor %}</span>{% endif %}
  </p>
  {% if row.summary %}<p class="excerpt">{{ row.summary }}</p>{% endif %}
  {% if row.why %}<p class="why"><span>Pourquoi c'est important</span> {{ row.why }}</p>{% endif %}
  {% if row.events or row.entities or row.themes or row.industries %}
  <p class="labels">
    {% for ev in row.events %}<span class="ev ev-{{ ev.key }}">{{ ev.label }}</span>{% endfor %}
    {% for k, label in row.themes %}<span class="theme">{{ label }}</span>{% endfor %}
    {% for k, label in row.industries %}<span class="industry">{{ label }}</span>{% endfor %}
    {% for e in row.entities[:5] %}{% if e.id != current %}<a class="chip chip-{{ e.kind }}" href="{{ root }}entite/{{ e.id }}.html">{{ e.name }}</a>{% endif %}{% endfor %}
  </p>
  {% endif %}
  {% if row.n_items > 1 %}
  <details class="sources">
    <summary>{{ row.n_items }} articles de {{ row.n_sources }} source{{ 's' if row.n_sources > 1 }}</summary>
    <ul>
      {% for s in row.sources %}
      <li><a href="{{ s.url }}" target="_blank" rel="noopener noreferrer">{{ s.title }}</a>
        <span class="list-meta">{{ s.source }}{% if s.via == 'gnews' %} · GN{% endif %} · {{ s.date }}</span></li>
      {% endfor %}
      {% if row.more_sources %}<li class="list-meta">… et {{ row.more_sources }} autre{{ 's' if row.more_sources > 1 }}</li>{% endif %}
    </ul>
  </details>
  {% endif %}
</article>
{% endmacro %}


{% macro filters(options, periods, default_days, default_domain, kind=None, show_segments=False,
                 show_domain=True, show_themes=False) %}
<div class="filters" data-default-days="{{ default_days }}" data-default-domain="{{ default_domain }}">
  <div class="filter-row">
    {% if show_domain %}
    <div class="segmented" role="group" aria-label="Domaine">
      <button type="button" data-domain="geospatial">Géospatial</button>
      <button type="button" data-domain="newspace">New Space</button>
      <button type="button" data-domain="all">Tout</button>
    </div>
    {% endif %}
    <label class="search">
      <span class="sr-only">Rechercher</span>
      <svg aria-hidden="true" viewBox="0 0 20 20" width="16" height="16"><path d="M8.5 3a5.5 5.5 0 0 1 4.38 8.83l3.65 3.64-1.06 1.06-3.64-3.65A5.5 5.5 0 1 1 8.5 3Zm0 1.5a4 4 0 1 0 0 8 4 4 0 0 0 0-8Z" fill="currentColor"/></svg>
      <input type="search" data-filter="q" placeholder="Rechercher (mot-clé, programme…)" autocomplete="off">
    </label>
    <label class="select">
      <span class="sr-only">Période</span>
      <select data-filter="days">
        {% for d in periods %}<option value="{{ d }}"{% if d == default_days %} selected{% endif %}>{{ d }} derniers jours</option>{% endfor %}
      </select>
    </label>
  </div>
  {% if options.analysed %}
  <div class="filter-row">
    <div class="segmented" role="group" aria-label="Impact">
      <button type="button" data-impact="0">Tous les sujets</button>
      <button type="button" data-impact="2">Impact moyen et fort</button>
      <button type="button" data-impact="3">Impact fort</button>
    </div>
    {% if options.industries %}
    <label class="select">
      <span class="sr-only">Industrie</span>
      <select data-filter="industries">
        <option value="">Toutes les industries</option>
        {% for k, label, n in options.industries %}<option value="{{ k }}">{{ label }} ({{ n }})</option>{% endfor %}
      </select>
    </label>
    {% endif %}
  </div>
  {% endif %}
  <div class="filter-row">
    <label class="select">
      <span class="sr-only">Région</span>
      <select data-filter="regions">
        <option value="">Toutes les régions</option>
        {% for k, label in options.regions %}<option value="{{ k }}">{{ label }}</option>{% endfor %}
      </select>
    </label>
    <label class="select">
      <span class="sr-only">Pays</span>
      <select data-filter="countries">
        <option value="">Tous les pays</option>
        {% for k, label, n in options.countries %}<option value="{{ k }}">{{ label }} ({{ n }})</option>{% endfor %}
      </select>
    </label>
    {% if kind %}
    <label class="select">
      <span class="sr-only">{{ 'Institution' if kind == 'institution' else 'Entreprise' }}</span>
      <select data-filter="entities">
        <option value="">{{ 'Toutes les institutions' if kind == 'institution' else 'Toutes les entreprises' }}</option>
        {% for k, label, n in options.entities %}<option value="{{ k }}">{{ label }} ({{ n }})</option>{% endfor %}
      </select>
    </label>
    {% endif %}
    {% if show_segments %}
    <label class="select">
      <span class="sr-only">Segment</span>
      <select data-filter="segments">
        <option value="">Tous les segments</option>
        {% for k, label in options.segments %}<option value="{{ k }}">{{ label }}</option>{% endfor %}
      </select>
    </label>
    {% endif %}
    <button type="button" class="reset" data-reset hidden>Effacer les filtres</button>
  </div>
  {% if show_themes and options.themes %}
  <div class="chips" role="group" aria-label="Famille d'événements">
    {% for k, label, n in options.themes %}
    <button type="button" class="theme-chip" data-theme="{{ k }}" aria-pressed="false">{{ label }} <span class="n" data-theme-count="{{ k }}">{{ n }}</span></button>
    {% endfor %}
  </div>
  {% endif %}
  {% if options.events %}
  <div class="chips" role="group" aria-label="Type d'événement">
    {% for k, label, n in options.events %}
    <button type="button" class="ev ev-{{ k }}" data-event="{{ k }}" aria-pressed="false">{{ label }} <span class="n" data-event-count="{{ k }}">{{ n }}</span></button>
    {% endfor %}
  </div>
  {% endif %}
  {% if options.moves %}
  <div class="chips" role="group" aria-label="Type de mouvement">
    {% for k, label, n in options.moves %}
    <button type="button" class="theme-chip" data-move="{{ k }}" aria-pressed="false">{{ label }} <span class="n" data-move-count="{{ k }}">{{ n }}</span></button>
    {% endfor %}
  </div>
  {% endif %}
</div>
{% endmacro %}


{% macro feed(groups, root, current=None) %}
<div class="feed" data-feed>
  {% for g in groups %}
  <section class="day" data-age="{{ g.age }}">
    <h3 class="day-label">{{ g.label }}</h3>
    {% for row in g.rows %}{{ story_card(row, root, current) }}{% endfor %}
  </section>
  {% endfor %}
  <p class="empty" hidden>Aucun sujet ne correspond à ces filtres. Élargir la période ou passer le domaine sur « Tout ».</p>
</div>
{% endmacro %}


{% macro sidebar_box(box, root, open=True) %}
<details class="side-box"{% if open %} open{% endif %}>
  <summary><h2>{{ box.title }}</h2>
    <span class="hint">sujets selon les filtres · clic : fiche</span></summary>
  {% for g in box.groups %}
  <div class="side-group">
    <h3>{{ g.label }}</h3>
    <ul>
      {% for e in g.entities %}
      <li data-side-entity="{{ e.id }}">
        <a href="{{ root }}{{ e.href }}">{{ e.name }}</a>
        <span class="n" data-live-count data-field="{{ box.field }}" data-key="{{ e.id }}">{{ e.count }}</span>
      </li>
      {% endfor %}
    </ul>
  </div>
  {% endfor %}
</details>
{% endmacro %}

{# Open tenders and latest awards of a country or entity (box from build.SiteData.tender_box). #}
{% macro tender_box(box, root, heading, more_href=None) %}
<section class="profile tender-box" id="appels-offres" aria-label="{{ heading }}">
  <h2>{{ heading }} <span class="count">{{ box.total }}</span></h2>
  {% if box.open %}
  <h3>Ouverts ({{ box.open | length }})</h3>
  <ul class="tender-list">
    {% for t in box.open[:8] %}
    <li>
      <a href="{{ t.url }}" target="_blank" rel="noopener noreferrer">{{ t.title }}</a>
      <span class="tender-meta">
        {% if t.deadline %}Date limite {{ t.deadline_label }}{% if t.days_left is not none %} <span class="t-left{% if t.days_left <= box.closing_soon %} soon{% endif %}">{{ "aujourd'hui" if t.days_left == 0 else "J-" ~ t.days_left }}</span>{% endif %}{% else %}Date limite non précisée{% endif %}
        · {{ t.buyer }}{% if t.value_label %} · {{ t.value_label }}{% endif %} · {{ t.source_label }}{% if t.fit == "forte" %} · <strong>adéquation forte</strong>{% endif %}
      </span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if box.awards %}
  <h3>Attributions récentes ({{ box.awards_count }})</h3>
  <ul class="tender-list">
    {% for t in box.awards %}
    <li>
      <a href="{{ t.url }}" target="_blank" rel="noopener noreferrer">{{ t.title }}</a>
      <span class="tender-meta">{{ t.published_label }} · {{ t.buyer }}{% if t.winners %} · attribué à {{ t.winners[:4] | map(attribute="name") | join(", ") }}{% endif %}{% if t.value_label %} · {{ t.value_label }}{% endif %}</span>
    </li>
    {% endfor %}
  </ul>
  {% endif %}
  {% if more_href %}<a class="more" href="{{ more_href }}">Tout voir sur la page Marché →</a>{% endif %}
</section>
{% endmacro %}
